def parse_ts(iso):
    if not iso:
        return None
    try:
        s = iso.replace("Z", "+00:00")
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return None


def get_ts(reading):
    if not reading:
        return ""
    for k in ("ts", "timestamp", "time", "datetime"):
        v = reading.get(k)
        if v:
            return v
    return ""


def fmt_sgt(iso):
    dt = parse_ts(iso)
    if dt is None:
        return "--"
    return dt.astimezone(SGT).strftime("%d/%m/%Y, %H:%M:%S SGT")


def age_str(iso):
    dt = parse_ts(iso)
    if dt is None:
        return "never"
    diff = (datetime.now(timezone.utc) - dt).total_seconds()
    if diff < 0:
        return "just now"
    if diff < 60:
        return str(int(diff)) + "s ago"
    if diff < 3600:
        return str(int(diff // 60)) + "m ago"
    return str(int(diff // 3600)) + "h ago"


def short_name(device_id):
    if device_id in DEVICES:
        return DEVICES[device_id]
    return device_id.split("-")[0] if device_id else "?"


